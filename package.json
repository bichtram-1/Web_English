{
  "name": "lingualeap-fullstack-datn",
  "version": "1.0.0",
  "description": "Nền tảng Học tiếng Anh Thông minh LinguaLeap - Đồ Án Tốt Nghiệp (Fullstack Architecture)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "db:studio": "npm --prefix backend run db:studio",
    "db:seed": "npm --prefix backend run db:seed",
    "db:push": "npm --prefix backend run db:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "english-learning",
    "flashcards",
    "react19",
    "express",
    "typescript",
    "datn",
    "fullstack",
    "prisma",
    "sqlite",
    "postgresql"
  ],
  "author": "LinguaTeam",
  "license": "MIT"
}
