{
  "name": "lingualeap-fullstack-datn",
  "version": "1.0.0",
  "description": "Nền tảng Học tiếng Anh Thông minh LinguaLeap - Đồ Án Tốt Nghiệp (Fullstack Architecture)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm install --prefix backend --include=dev && npm install --prefix frontend --include=dev && npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "vercel-build": "npm install --prefix backend --include=dev && npm install --prefix frontend --include=dev && npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "db:studio": "npm --prefix backend run db:studio",
    "db:seed": "npm --prefix backend run db:seed",
    "db:push": "npm --prefix backend run db:push"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1"
  },
  "keywords": [
    "english-learning",
    "flashcards",
    "react19",
    "express",
    "typescript",
    "datn",
    "fullstack",
    "prisma",
    "sqlite",
    "postgresql"
  ],
  "author": "LinguaTeam",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
