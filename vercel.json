{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/"
        }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "backend/src/app.ts",
      "installCommand": "npm install",
      "buildCommand": "npm run build:backend"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}